# Per-repository sandbox for the atmospheric-science tasks.
# Same base as the official harness (python:3.13-slim + git/pytest), plus compilers for the Cython
# extensions (Py-ART, pyresample, pysteps) and the repository's runtime + test dependencies.
# Network is only used while building; tasks run with network_mode=none.
#   docker build -f Dockerfile.met --build-arg REQ=req_satpy.txt -t met-sandbox-satpy .
FROM swebench-sandbox:latest

RUN apt-get update -q && DEBIAN_FRONTEND=noninteractive apt-get install -y -q --no-install-recommends \
        build-essential gfortran pkg-config libgeos-dev libproj-dev proj-data \
    && rm -rf /var/lib/apt/lists/*

ARG REQ
COPY ${REQ} /tmp/req.txt
RUN pip install --no-cache-dir -r /tmp/req.txt cython "setuptools-scm>=8" hatch-vcs hatch-cython \
        meson-python ninja pytest-timeout

# Test data that the libraries download at test time is pre-fetched by a networked warm-up run and
# committed into the image afterwards (see validate_tasks.py); these paths keep the caches in one place.
ENV POOCH_BASE_DIR=/opt/testcache \
    XDG_CACHE_HOME=/opt/testcache \
    PYSTEPSRC=/opt/pysteps-data/pystepsrc \
    MPLBACKEND=Agg
RUN mkdir -p /opt/testcache
